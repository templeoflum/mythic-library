            "siddhi-power",
            "gold-maker"
          ]
        },
        {
          "primordial": "primordial:trickster",
          "weight": 0.6,
          "aspects": [
            "escape-artist",
            "story-snare"
          ]
        },
        {
          "primordial": "primordial:wise-elder",
          "weight": 0.4,
          "aspects": [
            "teller-of-tales"
          ]
        }
      ],
