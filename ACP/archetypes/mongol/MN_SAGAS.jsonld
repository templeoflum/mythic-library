  "entries": [
    {
      "@id": "arch:MN-SIDDHI-KUR",
      "@type": "Archetype",
      "name": "Siddhi-kür",
      "aliases": [
        "Siddhî-kür",
        "Ssidi-kür",
        "The Magic Corpse"
      ],
      "domain": [
        "Storytelling",
        "Magic",
        "The Dead",
        "Riddles"
      ],
      "description": "\"A dead body endowed with supernatural or magic powers\" (Busk's note), the frame-figure of the Mongol Siddhi-kür cycle. Gold above the waist and emerald below, with a head of mother-of-pearl, he flees to his mango-tree in a grove of the dead. The master Nâgârjuna sends the Khan's son to bring him back bound in a sack, in silence; on the road the corpse tells him a tale, and whenever the carrier speaks a word, the Siddhi-kür escapes and the journey begins again.",
      "spectralCoordinates": {
        "order-chaos": 0.63,
        "creation-destruction": 0.44,
        "light-shadow": 0.45,
        "active-receptive": 0.37,
        "individual-collective": 0.45,
        "ascent-descent": 0.48,
        "stasis-transformation": 0.64,
        "voluntary-fated": 0.3
      },
      "instantiates": [
