    {
      "@id": "arch:TR-PERI",
      "@type": "Archetype",
      "name": "Peri",
      "aliases": [
        "Peris",
        "Pari",
        "Peri-maiden"
      ],
      "domain": [
        "Beauty",
        "Birth",
        "Blessing",
        "The Otherworld"
      ],
      "description": "The fairy race of the Anatolian tales, a byword for beauty. In The Three Orange-Peris a prince wins three oranges from the devils who guard them; when he cuts one open in the desert, a damsel \"lovely as a Peri\" pops out, begs for a drop of water, and vanishes because there is none. In The Rose-Beauty the walls of a poor hut open and three damsels of the Peri race step in to attend a birth, each speaking a gift over the new-born girl: pearls fall from her eyes when she weeps, roses bloom when she smiles, and a riband of green verdure follows her footsteps.",
      "spectralCoordinates": {
        "order-chaos": 0.44,
        "creation-destruction": 0.22,
        "light-shadow": 0.36,
        "active-receptive": 0.45,
        "individual-collective": 0.37,
        "ascent-descent": 0.48,
        "stasis-transformation": 0.6,
        "voluntary-fated": 0.35
      },
      "instantiates": [
        {
          "primordial": "primordial:maiden",
          "weight": 0.75,
          "aspects": [
            "otherworld-bride",
            "beauty"
          ]
        },
        {
