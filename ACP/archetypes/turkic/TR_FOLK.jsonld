      ],
      "status": "derived"
    },
    {
      "@id": "arch:TR-ANKA",
      "@type": "Archetype",
      "name": "Anka",
      "aliases": [
        "Emerald Anka",
        "Zümrüd-ü Anka",
        "Simurgh",
        "Simorgh"
      ],
      "domain": [
        "Birds",
        "Worlds Below and Above",
        "Gratitude",
        "Serpents"
      ],
      "description": "The emerald Anka, \"mother of the birds and the Padishah of the Peris\". A serpent destroys her young year by year. In The Cinder-Youth, when the hero Cinder-son, fallen into the seventh world, cuts the serpent in two, she shelters him with her wings, then carries him up through the layers of the worlds, fed forty tons of ox-flesh and forty pitchers of water whenever she cries \"Gik!\" and \"Gak!\". Bain compares her to the Bird Mogol and the Bird Zhar of the Russian and Cossack tales.",
      "spectralCoordinates": {
        "order-chaos": 0.36,
        "creation-destruction": 0.35,
        "light-shadow": 0.4,
        "active-receptive": 0.49,
        "individual-collective": 0.6,
